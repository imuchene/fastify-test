{
  "name": "fastify-test",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "index.js",
  "types": "index.d.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test test/**/*.test.js",
    "format": "prettier --plugin=prettier-plugin-ejs --write \"src/**/*.ts\" \"src/**/*.ejs\"",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "start": "node dist/index.js",
    "dev": "nodemon --watch src src/index.ts",
    "prepush": "npm run format && npm run lint"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@dotenvx/dotenvx": "^1.49.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/static": "^8.2.0",
    "@fastify/view": "^11.1.1",
    "csv-writer": "^1.6.0",
    "ejs": "^3.1.10",
    "fastify": "^5.0.0",
    "fastify-cli": "^7.4.0",
    "fastify-plugin": "^5.0.0",
    "prompt": "^1.3.0",
    "simpledotcss": "^2.3.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/ejs": "^3.1.5",
    "@types/node": "^24.3.1",
    "@types/prompt": "^1.1.9",
    "eslint": "^9.35.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "prettier-plugin-ejs": "^1.0.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0"
  }
}
